// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id
  email         String   @unique
  emailVerified Boolean  @default(false)
  name          String
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  accounts                Account[]
  sessions                Session[]
  organizationMemberships OrganizationMember[]
  ownedContracts          Contract[]           @relation("ContractOwner")
  createdContracts        Contract[]           @relation("ContractCreator")
  authoredVersions        ContractVersion[]
  partyAssignments        ContractParty[]
  signatureActions        ContractSignature[]  @relation("SignatureActor")
  auditEvents             ContractAuditLog[]   @relation("AuditActor")
  sentInvites             OrgInvite[]          @relation("SentInvites")
  contractApprovals       ContractApproval[]   @relation("ContractApprovals")
  createdTemplates        ContractTemplate[]   @relation("TemplateCreator")
  savedSearches           SavedSearch[]
}

model Account {
  id                    String    @id
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
}

model Session {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  legalName String?
  logoUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members       OrganizationMember[]
  contracts     Contract[]
  roles         OrgRole[]
  invites       OrgInvite[]
  templates     ContractTemplate[]
  savedSearches SavedSearch[]

  @@index([name])
}

model OrgRole {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  description    String?
  permissions    String   @default("[]")
  isSystemRole   Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members      OrganizationMember[]
  invites      OrgInvite[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model OrganizationMember {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  roleId         String
  joinedAt       DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         OrgRole      @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([roleId])
}

model OrgInvite {
  id              String    @id @default(cuid())
  organizationId  String
  email           String
  roleId          String
  token           String    @unique
  invitedByUserId String
  status          String    @default("PENDING")
  expiresAt       DateTime
  acceptedAt      DateTime?
  createdAt       DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role         OrgRole      @relation(fields: [roleId], references: [id], onDelete: Restrict)
  invitedBy    User         @relation("SentInvites", fields: [invitedByUserId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([email])
  @@index([organizationId])
}

model Contract {
  id                    String    @id @default(cuid())
  organizationId        String
  ownerUserId           String
  createdByUserId       String
  contractNumber        String
  title                 String
  description           String?
  contractType          String    @default("OTHER")
  status                String    @default("DRAFT")
  counterpartyName      String?
  effectiveAt           DateTime?
  expiresAt             DateTime?
  terminatedAt          DateTime?
  terminationReason     String?
  currencyCode          String    @default("USD")
  totalValueMinor       Int?
  approvalWorkflow      String    @default("SIMULTANEOUS")
  signingWorkflow       String    @default("SIMULTANEOUS")
  signatureType         String    @default("BOTH")
  signingLinkExpiryDays Int       @default(14)
  signedPdfBytes        Bytes?
  signedPdfGeneratedAt  DateTime?
  currentVersionId      String?   @unique
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ownerUser      User                @relation("ContractOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  createdByUser  User                @relation("ContractCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  currentVersion ContractVersion?    @relation("CurrentContractVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  versions       ContractVersion[]   @relation("ContractVersions")
  parties        ContractParty[]
  signatures     ContractSignature[]
  auditLogs      ContractAuditLog[]
  approvals      ContractApproval[]

  @@unique([organizationId, contractNumber])
  @@index([organizationId, status])
  @@index([organizationId, expiresAt])
  @@index([organizationId, effectiveAt])
  @@index([organizationId, createdAt])
  @@index([organizationId, totalValueMinor])
  @@index([organizationId, counterpartyName])
  @@index([contractType])
  @@index([ownerUserId])
  @@index([createdByUserId])
}

model ContractVersion {
  id              String   @id @default(cuid())
  contractId      String
  versionNumber   Int
  title           String?
  contentHtml     String
  contentJson     String?
  contentText     String?
  changeSummary   String?
  createdByUserId String?
  createdAt       DateTime @default(now())

  contract           Contract            @relation("ContractVersions", fields: [contractId], references: [id], onDelete: Cascade)
  createdByUser      User?               @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  currentForContract Contract?           @relation("CurrentContractVersion")
  signatures         ContractSignature[]

  @@unique([contractId, versionNumber])
  @@index([createdByUserId])
}

model ContractParty {
  id           String   @id @default(cuid())
  contractId   String
  userId       String?
  role         String   @default("COUNTERPARTY")
  legalName    String
  email        String?
  title        String?
  organization String?
  signingOrder Int?
  createdAt    DateTime @default(now())

  contract   Contract            @relation(fields: [contractId], references: [id], onDelete: Cascade)
  user       User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  signatures ContractSignature[]

  @@index([contractId, role])
  @@index([userId])
}

model ContractSignature {
  id                String    @id @default(cuid())
  contractId        String
  contractVersionId String?
  partyId           String
  status            String    @default("PENDING")
  requestedAt       DateTime  @default(now())
  viewedAt          DateTime?
  signedAt          DateTime?
  declinedAt        DateTime?
  reason            String?
  signedByUserId    String?
  signatureData     String?
  signatureType     String?
  ipAddress         String?
  userAgent         String?

  contract        Contract         @relation(fields: [contractId], references: [id], onDelete: Cascade)
  contractVersion ContractVersion? @relation(fields: [contractVersionId], references: [id], onDelete: SetNull)
  party           ContractParty    @relation(fields: [partyId], references: [id], onDelete: Cascade)
  signedByUser    User?            @relation("SignatureActor", fields: [signedByUserId], references: [id], onDelete: SetNull)
  signingToken    SigningToken?

  @@index([contractId, status])
  @@index([partyId])
  @@index([contractVersionId])
  @@index([signedByUserId])
  @@index([signedAt])
}

model SigningToken {
  id                  String    @id @default(cuid())
  contractSignatureId String    @unique
  token               String    @unique
  signingPath         String?
  expiresAt           DateTime
  usedAt              DateTime?
  createdAt           DateTime  @default(now())

  contractSignature ContractSignature @relation(fields: [contractSignatureId], references: [id], onDelete: Cascade)

  @@index([token])
}

model ContractAuditLog {
  id          String   @id @default(cuid())
  contractId  String
  actorUserId String?
  eventType   String
  details     String?
  createdAt   DateTime @default(now())

  contract  Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  actorUser User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([contractId, createdAt])
  @@index([actorUserId])
  @@index([eventType])
}

model ContractApproval {
  id         String    @id @default(cuid())
  contractId String
  approverId String
  order      Int       @default(0)
  status     String    @default("PENDING")
  comment    String?
  actedAt    DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  approver User     @relation("ContractApprovals", fields: [approverId], references: [id], onDelete: Cascade)

  @@unique([contractId, approverId])
  @@index([contractId, status])
  @@index([approverId])
}

model ContractTemplate {
  id              String   @id @default(cuid())
  organizationId  String
  createdByUserId String
  title           String
  description     String?
  contractType    String   @default("OTHER")
  contentHtml     String
  contentJson     String?
  contentText     String?
  variables       String   @default("[]")
  isActive        Boolean  @default(true)
  version         Int      @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdByUser User         @relation("TemplateCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([organizationId, isActive])
  @@index([createdByUserId])
}

model SavedSearch {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  name           String
  filters        String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, userId])
}
